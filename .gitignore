# ==========================================
# 產出檔案（可由腳本重新產出）
# ==========================================
*.html

# ==========================================
# 🔴 敏感資料 — 絕對不上傳
# ==========================================

# 真實成員設定（含姓名、內部 user ID）
team_config.json

# Wekan API 認證設定（含 API Token，絕對不上傳）
wekan_config.json

# Wekan 匯出的看板資料（含所有卡片、任務內容）
wekan json/

# 含組織名稱與成員資料的操作說明
CLAUDE.md

# 工作流再現指南（含內部架構決策與踩坑記錄）
PLAYBOOK.md

# 含系統名稱的最新版儀表板規格文件（SDD）
Task_dashboard_v6_SDD.md
Task_dashboard_v7_SDD.md

# 含真實專案名稱的變更紀錄
Changelog.md

# 含實際工作分析的週報草稿
週報儀表板草稿_*.md

# 協作記錄與反思（含對話歷史與個人工作模式）
prompt.md
reflection.md

# Session 啟動指引（個人協作設定，同 CLAUDE.md 類別）
session_start.md

# 里程碑個人補充筆記（含使用者手動填寫的內容）
milestone_notes.json

# AI 分析產出結果（內部工作內容，不對外公開）
AI分析結果/

# AI 分析個人設定（可能含使用者本機路徑）
ai_analysis_config.yaml

# AI 分析橋接觸發檔（含完整看板資料，屬機敏內容）
ai_request.json

# AI Prompt 模板（含使用者自訂指令與分析策略）
ai_prompt_template.md

# 資安規範文件（含內部風險說明）
資安風險規範.md

# 含組織資訊的新版規格文件
Task_dashboard_v7.md

# 含組織資訊的舊版規格文件
Task_dashboard.md
Task_dashboard_v1.md
Task_dashboard_v2.md
Task_dashboard_v3.md
Task_dashboard_v4.md
Task_dashboard_v5.md
kpi.md
wekan column definition.md

# ==========================================
# 系統與開發環境
# ==========================================
__pycache__/
*.pyc
*.pyo
.DS_Store
*.swp
*.swo
.env
